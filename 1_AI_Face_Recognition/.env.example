# ---- Face Recognition configuration ----
# Camera: 0 (webcam), a video path, or an rtsp:// / http:// stream URL
FR_CAMERA_SOURCE=0
FR_CAMERA_WIDTH=1280
FR_CAMERA_HEIGHT=720
FR_PROCESS_SCALE=0.5

# Recognition: lower CONFIDENCE_GATE = stricter (LBPH L2 distance)
FR_RECOGNIZER=lbph
FR_CONFIDENCE_GATE=80
FR_MIN_FACE_PX=80
FR_FACE_SIZE=200
FR_CONFIRM_FRAMES=3
FR_EVENT_COOLDOWN=30

# Anti-spoofing (reject printed photos / still screens)
FR_REQUIRE_LIVENESS=true
FR_LIVENESS_EPS=2.5

# Attendance policy (24h local time)
FR_SHIFT_START=08:00
FR_LATE_AFTER=09:00
FR_SHIFT_END=17:00

# Storage
FR_DB_PATH=faces.db
FR_MODEL_PATH=lbph_model.yml
FR_DATASET_DIR=faces_dataset
FR_SNAPSHOT_DIR=snapshots
FR_EXPORT_DIR=exports

# REST API
FR_API_HOST=127.0.0.1
FR_API_PORT=8001
